#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, q;
    cin >> n >> q;

    vector<long long> diff(n + 2, 0);

    for (int i = 0; i < q; i++) {
        int l, r;
        long long v;
        cin >> l >> r >> v;
        diff[l] += v;
        diff[r + 1] -= v;
    }

    vector<long long> a(n + 1, 0);
    long long cur = 0;
    for (int i = 1; i <= n; i++) {
        cur += diff[i];
        a[i] = cur;
    }

    for (int i = 1; i <= n; i++) {
        cout << a[i];
        if (i < n) cout << ' ';
    }
    cout << '\n';

    return 0;
}
