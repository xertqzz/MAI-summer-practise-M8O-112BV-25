#include <bits/stdc++.h>
using namespace std;

int main() {
    long long x1, y1, x2, y2, x3, y3, x4, y4;
    cin >> x1 >> y1 >> x2 >> y2;
    cin >> x3 >> y3 >> x4 >> y4;

    long long ax1 = min(x1, x2), ax2 = max(x1, x2);
    long long ay1 = min(y1, y2), ay2 = max(y1, y2);
    long long bx1 = min(x3, x4), bx2 = max(x3, x4);
    long long by1 = min(y3, y4), by2 = max(y3, y4);

    long long area1 = (ax2 - ax1) * (ay2 - ay1);
    long long area2 = (bx2 - bx1) * (by2 - by1);

    long long ix1 = max(ax1, bx1), ix2 = min(ax2, bx2);
    long long iy1 = max(ay1, by1), iy2 = min(ay2, by2);

    long long intersection = 0;
    if (ix2 > ix1 && iy2 > iy1) {
        intersection = (ix2 - ix1) * (iy2 - iy1);
    }

    cout << area1 + area2 - intersection << endl;
    return 0;
}
