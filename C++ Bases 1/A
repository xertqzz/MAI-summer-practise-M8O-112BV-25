#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<long long> a(n + 1);
    for (int i = 1; i <= n; i++) cin >> a[i];

    int l, r;
    while (cin >> l >> r) {
        if (l == 0 && r == 0) break;
        reverse(a.begin() + l, a.begin() + r + 1);
    }

    for (int i = 1; i <= n; i++) {
        cout << a[i] << " \n"[i == n];
    }
    return 0;
}
