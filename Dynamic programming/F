#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    vector<int> dp(N + 1, 0);
    dp[1] = 0;

    for (int i = 2; i <= N; i++) {
        int best = i + dp[i - 1];
        if (i % 2 == 0) best = min(best, i + dp[i / 2]);
        if (i % 3 == 0) best = min(best, i + dp[i / 3]);
        dp[i] = best;
    }

    cout << dp[N] << '\n';

    return 0;
}
