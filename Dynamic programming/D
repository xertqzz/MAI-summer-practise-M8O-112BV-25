#include <bits/stdc++.h>
using namespace std;

const long long MOD = 1e9 + 7;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m, k;
    cin >> n >> m >> k;

    vector<vector<bool>> dangerous(n + 1, vector<bool>(m + 1, false));
    for (int i = 0; i < k; i++) {
        int x, y;
        cin >> x >> y;
        dangerous[x][y] = true;
    }

    vector<vector<long long>> dp(n + 1, vector<long long>(m + 1, 0));

    dp[0][0] = dangerous[0][0] ? 0 : 1;

    for (int i = 0; i <= n; i++) {
        for (int j = 0; j <= m; j++) {
            if (i == 0 && j == 0) continue;
            if (dangerous[i][j]) {
                dp[i][j] = 0;
                continue;
            }
            long long ways = 0;
            if (i > 0) ways += dp[i - 1][j];
            if (j > 0) ways += dp[i][j - 1];
            dp[i][j] = ways % MOD;
        }
    }

    cout << dp[n][m] << '\n';

    return 0;
}
