#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        long long n;
        cin >> n;

        if (n == 0) {
            cout << 10 << '\n';
            continue;
        }

        if (n == 1) {
            cout << 1 << '\n';
            continue;
        }

        vector<int> digits;
        long long cur = n;

        for (int d = 9; d >= 2; d--) {
            while (cur % d == 0) {
                cur /= d;
                digits.push_back(d);
            }
        }

        if (cur != 1) {
            cout << -1 << '\n';
            continue;
        }

        sort(digits.begin(), digits.end());
        for (int x : digits) cout << x;
        cout << '\n';
    }

    return 0;
}
