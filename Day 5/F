#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<long long> cnt(8, 0);
    for (int i = 0; i < n; i++) {
        int a;
        cin >> a;
        cnt[a]++;
    }

    if (cnt[5] != 0 || cnt[7] != 0) {
        cout << -1 << '\n';
        return 0;
    }

    long long x = cnt[4];
    long long y = cnt[2] - cnt[4];
    long long z = cnt[3];

    if (y < 0) {
        cout << -1 << '\n';
        return 0;
    }

    if (cnt[1] != x + y + z || cnt[6] != y + z) {
        cout << -1 << '\n';
        return 0;
    }

    for (long long i = 0; i < x; i++) cout << "1 2 4\n";
    for (long long i = 0; i < y; i++) cout << "1 2 6\n";
    for (long long i = 0; i < z; i++) cout << "1 3 6\n";

    return 0;
}
