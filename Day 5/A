#include <bits/stdc++.h>
using namespace std;

long long gcd_ll(long long a, long long b) {
    while (b) {
        a %= b;
        swap(a, b);
    }
    return a;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<long long> t(n);
    for (int i = 0; i < n; i++) cin >> t[i];

    long long ans = 1;
    for (int i = 0; i < n; i++) {
        long long g = gcd_ll(ans, t[i]);
        ans = ans / g * t[i];
    }

    cout << ans << '\n';

    return 0;
}
